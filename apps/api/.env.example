# Server Configuration
PORT=3006
# Set to specific origin(s) in production, e.g. https://yourapp.com
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Coinbase Developer Platform (CDP) - https://developer.coinbase.com
BASE_RPC_ENDPOINT=https://api.developer.coinbase.com/rpc/v1/base/your-api-key-here
CDP_KEY_ID=your-cdp-key-id-here
CDP_API_KEY=your-cdp-api-key-here

# Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_a_secure_random_string

# Etherscan / Basescan - https://etherscan.io/apis
ETHERSCAN_API_KEY=your-etherscan-api-key-here
BASESCAN_API_KEY=your-basescan-api-key-here

# Alchemy - https://www.alchemy.com
ALCHEMY_API_KEY=your-alchemy-api-key-here

# Custom RPC Endpoint (optional - overrides the default public endpoint)
CUSTOM_RPC_ENDPOINT=https://your-custom-rpc-endpoint-here/
