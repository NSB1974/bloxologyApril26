# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=your-jwt-secret-here

# Etherscan API (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=your-etherscan-api-key-here

# Basescan API (https://basescan.org/myapikey) - optional, falls back to ETHERSCAN_API_KEY
BASESCAN_API_KEY=your-basescan-api-key-here

# Alchemy API (https://dashboard.alchemy.com/)
ALCHEMY_API_KEY=your-alchemy-api-key-here

# Coinbase Developer Platform (https://portal.cdp.coinbase.com/)
CDP_KEY_ID=your-cdp-key-id-here
CDP_API_KEY=your-cdp-api-key-here

# RPC Endpoints (optional)
CUSTOM_RPC_ENDPOINT=
BASE_RPC_ENDPOINT=https://base-rpc.publicnode.com
