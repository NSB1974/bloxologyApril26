{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/apps/web",
  "installCommand": "npm install --include=dev",
  "rewrites": [
    {
      "source": "/hcgi/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
