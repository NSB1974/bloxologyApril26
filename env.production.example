# Copy this file to env.production and fill in real values.
# NEVER commit env.production to version control.
# On Hostinger, set these via the Node.js environment variables panel instead.

PORT=3006
CORS_ORIGIN=https://yourdomain.com
NODE_ENV=production

# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# Coinbase Developer Platform (CDP)
BASE_RPC_ENDPOINT=https://api.developer.coinbase.com/rpc/v1/base/<your-key>
CDP_KEY_ID=<your-cdp-key-id>
CDP_API_KEY=<your-cdp-api-key>

# Etherscan
ETHERSCAN_API_KEY=<your-etherscan-api-key>

# Alchemy
ALCHEMY_API_KEY=<your-alchemy-api-key>

# QuickNode (or other custom RPC provider)
CUSTOM_RPC_ENDPOINT=https://<your-quicknode-endpoint>/
