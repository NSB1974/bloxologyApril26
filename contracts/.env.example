# Private key (from `cast wallet import <account-name>` or stored in ~/.foundry/keystores/)
# DO NOT COMMIT THIS FILE - use `cast wallet import` to store keys securely
PRIVATE_KEY=

# Etherscan/BaseScan API Key for contract verification
# Get from: https://basescan.org/apidashboard or https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=

# Optional: Wallet keystore name (if using `cast wallet` instead of PRIVATE_KEY)
# Format: Account name created via `cast wallet import --keystore <path> <account>`
KEYSTORE_ACCOUNT=

# Base RPC endpoints (optional, defaults are set in foundry.toml)
# Mainnet: https://mainnet.base.org
# Sepolia: https://sepolia.base.org
BASE_RPC_MAINNET=
BASE_RPC_SEPOLIA=
